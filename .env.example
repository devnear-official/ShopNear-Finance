# ShopNear Finance Environment Variables

# MongoDB connection string (Replica set recommended for transactions)
MONGODB_URI=mongodb://localhost:27017/shopnear_finance?replicaSet=rs0

# JWT Secrets (use min 32 characters in production)
JWT_ACCESS_SECRET=shopnear_finance_super_secure_access_secret_key_2026_at_least_32_chars
JWT_REFRESH_SECRET=shopnear_finance_super_secure_refresh_secret_key_2026_at_least_32_chars

# Application URL
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Timezone & Currency
DEFAULT_TIMEZONE=Asia/Dhaka
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_CURRENCY_SYMBOL=৳

# Email / SMTP (Dev defaults to console log)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ShopNear Finance <noreply@shopnear.test>"
RESEND_API_KEY=

# Storage & Cloudinary
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
STORAGE_PATH=./uploads
